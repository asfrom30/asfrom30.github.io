---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/i18n";
import { SECTIONS } from "@/sections";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const currentYear = new Date().getFullYear();
const url = (path: string) => getRelativeLocaleUrl(locale, path);

type FooterLink = { label: string; href: string; external?: boolean };

// 칸마다 제목과 링크 목록. 칸을 늘리거나 링크를 바꾸려면 여기만 고친다.
const columns: { title: string; links: FooterLink[] }[] = [
  {
    title: t.nav.posts,
    links: SECTIONS.map(({ slug, name }) => ({ label: name, href: url(slug) })),
  },
  {
    title: "둘러보기",
    links: [
      { label: "전체 글", href: url("posts") },
      { label: t.nav.archives, href: url("archives") },
      { label: t.nav.search, href: url("search") },
    ],
  },
  {
    title: t.nav.about,
    links: [
      { label: "학력 및 경력", href: url("about") },
      {
        label: "RSS",
        href: `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`,
      },
    ],
  },
  {
    title: "연락",
    links: config.socials.map(({ name, url: href }) => ({
      label:
        name === "github"
          ? "GitHub"
          : name === "linkedin"
            ? "LinkedIn"
            : name === "x"
              ? "X"
              : name.charAt(0).toUpperCase() + name.slice(1),
      href,
      external: true,
    })),
  },
];
---

<!-- 구분선은 화면 전체 폭으로 긋고, 내용은 본문 폭 안에 둔다 -->
<footer
  class:list={[
    "border-border border-t",
    { "mt-auto": !noMarginTop },
    className,
  ]}
  {...attrs}
>
  <div class="app-layout pt-10 pb-8">
    <nav
      aria-label="사이트 링크"
      class="grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4"
    >
      {
        columns
          .filter(({ links }) => links.length > 0)
          .map(({ title, links }) => (
            <div>
              <h2 class="mb-3 font-bold">{title}</h2>
              <ul class="text-muted-foreground space-y-1.5 text-sm">
                {links.map(({ label, href, external }) => (
                  <li>
                    <a
                      href={href}
                      class="hover:text-accent transition-colors"
                      {...(external && {
                        target: "_blank",
                        rel: "noopener noreferrer",
                      })}
                    >
                      {label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
      }
    </nav>

    <p class="text-muted-foreground mt-12 text-center text-sm">
      &#169; {currentYear}
      {config.site.title} · {config.site.author}
    </p>
  </div>
</footer>
